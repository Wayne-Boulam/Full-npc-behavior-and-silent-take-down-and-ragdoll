local function chase(player)
	if not player or not player.Character then return end
	local targetHRP = player.Character:FindFirstChild("HumanoidRootPart")
	if not targetHRP then return end
	local humanoid = npc:FindFirstChildOfClass("Humanoid")
	if not humanoid then return end

	--print("Chase started.")
	RunAnim:Fire()

	while true do
		-- If stunned → pause movement until unstunned
		if npc:GetAttribute("Stunned") then
			local hrp = npc:FindFirstChild("HumanoidRootPart")
			if hrp then hrp.Anchored = true end

			-- Wait until stun ends
			local npcHRP = npc:FindFirstChild("HumanoidRootPart")
			local targetHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if npcHRP and targetHRP then
				-- Keep Y level so NPC doesn't tilt up/down
				local lookAtPos = Vector3.new(targetHRP.Position.X, npcHRP.Position.Y, targetHRP.Position.Z)
				npcHRP.CFrame = CFrame.lookAt(npcHRP.Position, lookAtPos)
			end

			repeat task.wait(0.05) until not npc:GetAttribute("Stunned")
			if hrp then hrp.Anchored = false end
		end

		-- Stop if target disappears or dies
		if not player.Character or not player.Character:FindFirstChild("HumanoidRootPart") then
			break
		end
		if player.Character:FindFirstChildOfClass("Humanoid").Health <= 0 then
			break
		end
		distance = (NPC.HumanoidRootPart.Position - targetHRP.Position).Magnitude
		--print(distance)
		if distance < 15  then
			fighting(player)
		end
		-- Move toward target
		humanoid:MoveTo(targetHRP.Position)
		task.wait(0.1)
	end

	--print("Chase ended.")
end


local function detectPlayerLoop()
	while true do
		task.wait(0.2)
		if npc:GetAttribute("Detected") == false then
			for _, player in ipairs(Players:GetPlayers()) do
				local character = player.Character
				if character and character:FindFirstChild("HumanoidRootPart") then
					local targetPos = character.HumanoidRootPart.Position
					local npcPos = npc.PrimaryPart.Position

					-- Horizontal distance only
					local flatNPC = Vector3.new(npcPos.X, 0, npcPos.Z)
					local flatTarget = Vector3.new(targetPos.X, 0, targetPos.Z)
					local distance = (flatTarget - flatNPC).Magnitude

					if distance <= 50 then
						-- FOV check (180° front view)
						local dirToPlayer = (flatTarget - flatNPC).Unit
						local facingDir = npc.PrimaryPart.CFrame.LookVector
						local angle = math.deg(math.acos(facingDir:Dot(dirToPlayer)))

						if angle <= 80 then
							-- Height difference check (within ±5 studs vertically)
							local yDiff = math.abs(targetPos.Y - npcPos.Y)
							if yDiff <= 5 then
								-- Raycast (line of sight) check
								local rayParams = RaycastParams.new()
								rayParams.FilterDescendantsInstances = {npc}
								rayParams.FilterType = Enum.RaycastFilterType.Blacklist
								rayParams.IgnoreWater = true

								local rayOrigin = npc.PrimaryPart.Position
								local rayDirection = (targetPos - rayOrigin)
								local result = workspace:Raycast(rayOrigin, rayDirection, rayParams)

								if result and result.Instance and not result.Instance:IsDescendantOf(character) then
									--print("Line of sight blocked by:", result.Instance:GetFullName())
									continue -- Skip detection, blocked
								end

								-- Player is visible and valid
								--print("Player Detected:", player)
								--print(distance)
								--print("DETECTED")
								npc:SetAttribute("Detected", true)
								--print("DETECTED")
								chase(player)
								return -- Exit detection loop
							end
						end
					end
				end
			end
		else
			--print("DETECTED IS TRUEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEEE")
		end
	end
end


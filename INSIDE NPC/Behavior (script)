local function patrol()
	if rerunpatrol == 1 then
		if not npc:GetAttribute("Detected") then
			while true do
				local currentWaypoint = waypoints[currentIndex]
				--print("Moving to:", currentWaypoint.Name)

				-- Exit early if detected before move starts
				if npc:GetAttribute("Detected") then break end
				--print(npc:GetAttribute("Detected"))
				WalkAnim:Fire()
				moveToTarget(currentWaypoint.Position)

				-- Exit early if detected after move ends
				if npc:GetAttribute("Detected") then
					--print("detect is trueeeeeeeeeeeeeeeeeeeeeeee")
					rerunpatrol = 0
					break
				end

				currentIndex += 3
				if currentIndex > #waypoints then
					currentIndex = 1
				end
				--print("Waiting for finished...")
				--print("detect is true")
			end
		else
			return
		end
	else
		rerunpatrol = 1
	end
end

local radius = 50
local params = OverlapParams.new()
params.FilterType = Enum.RaycastFilterType.Blacklist
params.FilterDescendantsInstances = {npc} -- Ignore self

local function ScanNearbyNPCs(player)
	local parts = workspace:GetPartBoundsInRadius(npc:GetPivot().Position, radius, params)
	local found = {}
	local attackingCount = 0
	local candidates = {}

	-- Add this NPC first
	table.insert(candidates, {
		Model = npc,
		Distance = (player.Character.HumanoidRootPart.Position - npc.HumanoidRootPart.Position).Magnitude
	})

	for _, part in ipairs(parts) do
		local model = part:FindFirstAncestorOfClass("Model")
		if model and not found[model] and model ~= npc then
			found[model] = true -- only process once

			-- Only consider NPCs that actually have NPCAttacking attribute
			if model:FindFirstChild("Humanoid") and model.Humanoid.Health > 0 then
				-- ✅ Only count living NPCs
			
			if model:GetAttribute("NPCAttacking") ~= nil then
				local state = model:GetAttribute("NPCAttacking")
				--print("Model:", model.Name, "| NPCAttacking:", state)

				if state == true then
					attackingCount += 1
				end

				-- Track for closest check
				if model:FindFirstChild("HumanoidRootPart") then
					local dist = (player.Character.HumanoidRootPart.Position - model.HumanoidRootPart.Position).Magnitude
					table.insert(candidates, {Model = model, Distance = dist})
				end
			end
			end
		end
	end

	-- ✅ Rule 1: If this NPC is the ONLY one nearby
	if #candidates == 1 then
		return true
	end

	-- ✅ Rule 2: If there are exactly  3 NPCs total (this npc + one other)
	if #candidates == 3 then
		return true
	end

	-- ✅ Rule 3: Less than 2 actively attacking AND npc is closest, 2nd, or 3rd closest
	if attackingCount < 2 then
		table.sort(candidates, function(a, b)
			return a.Distance < b.Distance
		end)

		if candidates[1] and candidates[1].Model == npc then
			return true
		elseif candidates[2] and candidates[2].Model == npc then
			return true
		end
	elseif candidates[3] and candidates[3].Model == npc then
	   if math.random(0,1) == 1 then
			return true
	   end
	end
	


	-- ❌ Rule 4: Otherwise false
	return false
end


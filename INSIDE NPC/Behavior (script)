local PathfindingService = game:GetService("PathfindingService")

local function moveToTarget(targetPosition)
	if npc:GetAttribute("Stunned") then
		--print("cancelinng")
		return -- cancel this mid-path update completely
	end

	if rerun == 1 then
		humanoid.WalkSpeed = 8
		local path = PathfindingService:CreatePath({
			AgentRadius = 2,
			AgentHeight = 5,
			AgentCanJump = true,
			AgentCanClimb = true,
		})

		path:ComputeAsync(npc.HumanoidRootPart.Position, targetPosition)

		if path.Status == Enum.PathStatus.Success then
			for _, w in ipairs(path:GetWaypoints()) do
				local p = Instance.new("Part")
				p.Size = Vector3.new(0.4,0.4,0.4)
				p.Anchored = true
				p.CanCollide = false
				p.Position = w.Position
				p.Shape = Enum.PartType.Ball
				p.Material = Enum.Material.Neon
				p.Color = Color3.new(1,0,0)
				p.Parent = workspace
				game:GetService("Debris"):AddItem(p, 22)
			end

			for _, waypoint in ipairs(path:GetWaypoints()) do
				local reached = false
				humanoid:MoveTo(waypoint.Position)

				local moveConnection
				moveConnection = humanoid.MoveToFinished:Connect(function(reachedTarget)
					reached = reachedTarget
				end)

				repeat
					task.wait(0.1)
					-- Abort path if detection happens
					if npc:GetAttribute("Detected") == true then
						--print("Movement interrupted: Player detected")
						rerun = 0
						humanoid:MoveTo(npc.HumanoidRootPart.Position) -- Stop moving
						if moveConnection then
							moveConnection:Disconnect()
						end
						return -- <-- Exit function
					end
				until reached or not npc or not npc.Parent

				if moveConnection then
					moveConnection:Disconnect()
				end

				if not reached then
					warn("Failed to reach waypoint. NPC might be stuck.")
					return
				end
			end

			-- Only reaches here if full path completed
			--print("Reached target position")
			idleAnim:Fire()
			task.wait(20)
			finished:Fire()
		else
			warn("Pathfinding failed with status:", path.Status.Name)
		end
	else
		rerun = 1
	end
end


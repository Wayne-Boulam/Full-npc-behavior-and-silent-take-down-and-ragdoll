local function waitForFinished()
	local finishedFlag = false
	-- Connect once
	local conn = finished.Event:Connect(function()
		finishedFlag = true
	end)
	-- Wait until the event is fired
	repeat task.wait(0.1) until finishedFlag
	conn:Disconnect() -- Clean up connection
end


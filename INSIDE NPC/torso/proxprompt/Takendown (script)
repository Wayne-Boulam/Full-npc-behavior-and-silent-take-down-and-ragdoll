local limbs = { "Head", "Torso", "Left Arm", "Right Arm", "Left Leg", "Right Leg" }

-- === Create Collision Part for Each Limb ===
local function createColliderFor(part)
	if not part or not part:IsA("BasePart") then return end

	local collider = Instance.new("Part")

	if part.Name == "Head" then
		collider.Size = part.Size * 0.3
	else
		collider.Size = part.Size * 0.7
	end

	collider.CFrame = part.CFrame
	collider.Anchored = false
	collider.CanCollide = true
	collider.Massless = true
	collider.Transparency = 0.5
	collider.Name = part.Name .. "_Collider"
	collider.BrickColor = BrickColor.Red()
	collider.Material = Enum.Material.Neon
	collider.Parent = NPC

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = collider
	weld.Part1 = part
	weld.Parent = collider
end

-- === Convert Motor6D to BallSocket ===
local function replaceJointWithBallSocket(motor)
	local part0 = motor.Part0
	local part1 = motor.Part1
	if not part0 or not part1 then return end

	local a0 = Instance.new("Attachment", part0)
	local a1 = Instance.new("Attachment", part1)

	-- Position the attachments at the motor's joint
	a0.Position = motor.C0.Position
	a1.Position = motor.C1.Position

	local socket = Instance.new("BallSocketConstraint")
	socket.Attachment0 = a0
	socket.Attachment1 = a1
	socket.LimitsEnabled = true
	socket.UpperAngle = 45
	socket.TwistLimitsEnabled = true
	socket.TwistLowerAngle = -45
	socket.TwistUpperAngle = 45

	socket.Parent = part0

	motor:Destroy()
end

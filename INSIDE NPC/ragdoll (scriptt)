-- Listen for ragdoll event
RagdollCall.OnServerEvent:Connect(function(Attacker, Isme)
	if Isme == script.Parent then
		
		if rig:GetAttribute("Ragdolled") then
			return
		end
		forceFullReset() -- Always start fresh
	

		local AttackerHrp = Attacker.Character and Attacker.Character:FindFirstChild("HumanoidRootPart")
		local VictimHrp = Isme and Isme:FindFirstChild("HumanoidRootPart")
		if not (AttackerHrp and VictimHrp) then
			return
		end

		-- Save rotation
		rootsavedrotation = root.CFrame - root.Position

		-- Apply push force before ragdoll
		local direction = (VictimHrp.Position - AttackerHrp.Position).Unit
		VictimHrp.AssemblyLinearVelocity = direction * 35

		
		rig.HumanoidRootPart.Anchored = false

		-- Add colliders
		for _, name in ipairs(limbs) do
			local limb = rig:FindFirstChild(name)
			if limb then
				createColliderFor(limb)
			end
		end

		-- Swap joints to ragdoll
		for _, descendant in ipairs(rig:GetDescendants()) do
			if descendant:IsA("Motor6D") then
				replaceJointWithBallSocket(descendant)
			end
		end

		if humanoid then
			humanoid.RequiresNeck = false
			humanoid.PlatformStand = true
		end
		local hum = rig:FindFirstChildOfClass("Humanoid")
		if hum and hum.Health > 0 then
			task.delay(3, cancelRagdoll)
		else
			if script.Parent.BehaviorScript  then
				script.Parent.BehaviorScript:Destroy()

			end
			script.Parent.AnimHandler:Destroy()
			script.Parent.Ragdoll:Destroy()
		end
	  task.wait(0.1)
		rig:SetAttribute("Ragdolled", true)
	end
end)

